{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:webview:allow-internal-toggle-devtools",
    "core:event:default",
